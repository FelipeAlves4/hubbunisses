# Use values from your own Supabase project. Never expose a service_role/secret key in a browser app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shared session cookie domain in production, for example .asexbusiness.com.br. Leave blank on localhost.
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=
NEXT_PUBLIC_ASEX_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_PRECIFICA_URL=http://localhost:3001
